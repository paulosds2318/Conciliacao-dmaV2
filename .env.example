# Modelo de configuração. Copie para .env (local) ou cadastre no AWS Secrets Manager (produção).
# Nunca coloque valores reais neste arquivo.

# Banco e autenticação (obrigatórios em produção; a aplicação não sobe sem eles)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conciliacao_dma?schema=public"
BETTER_AUTH_SECRET="gere-com: openssl rand -base64 48"
BETTER_AUTH_URL="http://localhost:3000"

# IA (análise de voucher e contrato). O modelo precisa ler PDF e imagem.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Coral. Homologação: homologservicescoral.aluguefoco.com.br | Produção: servicescoral.aluguefoco.com.br
CORAL_AUTH_TOKEN=""
CORAL_USERNAME=""
CORAL_PASSWORD=""
CORAL_CONTRACT_LOOKUP_URL="https://homologservicescoral.aluguefoco.com.br/api/rentagreement/{CONTRATO}"
CORAL_DMA_ELIGIBILITY_URL="https://homologservicescoral.aluguefoco.com.br/api/rentagreement/dma/eligibility"
# true = ações no Coral são simuladas. Desligue só após homologar.
MODO_TESTE_API="true"

# Documentos (voucher e contrato). Com DOCUMENT_STORAGE_BUCKET preenchido, usa S3; senão, o disco.
DOCUMENT_STORAGE_BUCKET=""
DOCUMENT_STORAGE_PREFIX="documents"
DOCUMENT_STORAGE_REGION=""
DOCUMENT_STORAGE_KMS_KEY_ID=""
DOCUMENT_STORAGE_PATH="./private-uploads"
# true em produção: impede subir sem bucket (documentos no disco do container se perdem a cada deploy)
REQUIRE_DOCUMENT_BUCKET="false"
MAX_PDF_SIZE_MB="20"

# Primeiro acesso (usados só pelo script prisma/seed.ts)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ATTENDANT_EMAIL=""
SEED_ATTENDANT_PASSWORD=""
# Lojas do atendente inicial, separadas por vírgula (ex.: SAO10,SAO11)
SEED_ATTENDANT_STORES=""

# Segurança: origens que podem exibir a aplicação em iframe
FRAME_ANCESTORS="'self'"
